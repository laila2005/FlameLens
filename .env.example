# Copy this file to .env and fill in. Never commit .env.

# AI model (see docs/07-ai-guide.md)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_CACHE=true
# true = /api/explain calls the model when no cached answer exists (local use only; Vercel has no model)
LLM_LIVE=false

# App
DATA_DIR=data/curated
SHOW_SAMPLE_BANNER=true
