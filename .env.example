# Copy this file to .env and fill in. Never commit .env.

# AI model (see docs/07-ai-guide.md)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_CACHE=true
# true = /api/explain calls the model when no cached answer exists (local use only; Vercel has no model)
LLM_LIVE=false

# App
DATA_DIR=data/curated
SHOW_SAMPLE_BANNER=true

# "Ask the NASA reports" (backend/app/ask.py). Optional: without a key the panel shows matching passages.
# Set the key in the hosting dashboard (Vercel environment variables), never in this file or the repo.
ASK_LLM_BASE_URL=https://api.groq.com/openai/v1
ASK_LLM_MODEL=openai/gpt-oss-120b
ASK_LLM_API_KEY=
# Or Google: set GOOGLE_API_KEY (AI Studio "AIza..." keys -> Gemini API; Vertex AI "AQ..." keys -> Vertex AI).
# Provider is guessed from the key; override with ASK_LLM_PROVIDER=gemini|vertex. Default model gemini-2.5-flash.
GOOGLE_API_KEY=
